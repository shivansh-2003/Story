# Use Neon's pooled (-pooler) endpoint. Note the driver is asyncpg, not the
# psycopg-style "postgresql://...?sslmode=require" string Neon's dashboard
# gives you — swap the scheme and drop the query params (see DATABASE_SSL_REQUIRE below).
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.neon.tech/dbname

# Set to false only for local Postgres without SSL.
DATABASE_SSL_REQUIRE=true

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=dev
# DEBUG also logs per-query duration (see app/database.py)
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0

# "openai" or "ollama"
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:latest
